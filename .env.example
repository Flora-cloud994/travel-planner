# ============================================================================
# travel-planner 环境变量示例
# ----------------------------------------------------------------------------
# 复制本文件为 .env（本地开发用），或在 Vercel 项目
# Settings → Environment Variables 中逐条添加（线上部署用）。
#
# ⚠️ .env 已被 .gitignore 忽略，请勿把真实 Key 提交到仓库。
# ============================================================================

# 阿里云百炼（DashScope）API Key —— 用于千问文本 / 视觉识别
# 获取地址：阿里云百炼控制台 → API-KEY 管理
DASHSCOPE_KEY=

# 高德开放平台 Key —— 必须申请「Web 服务」类型
# 获取地址：高德开放平台控制台 → 应用管理 → 添加 Key → 服务平台选「Web服务」
AMAP_KEY=

# 腾讯位置服务 Key —— 用于「到达点搜索」（车站 / 机场）【可选】
# 获取地址：腾讯位置服务控制台 → 应用管理 → 添加 Key → 勾选「WebService API」
# 不填也能正常部署：页面其他功能不受影响，仅「到达点搜索」搜不到结果，
# 接驳方案会退化为按坐标距离估算（仍可正常显示费用与时间）。
TMAP_KEY=
