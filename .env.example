# ============================================================================
# travel-planner 环境变量示例
# ----------------------------------------------------------------------------
# 复制本文件为 .env（本地开发用），或在 Vercel 项目
# Settings → Environment Variables 中逐条添加（线上部署用）。
#
# ⚠️ .env 已被 .gitignore 忽略，请勿把真实 Key 提交到仓库。
# ============================================================================

# 【必需】DeepSeek API Key —— 用于「文本识别」（粘贴攻略文案 → 抽取地点）
# 获取地址：https://platform.deepseek.com/api_keys
# 格式：sk- 开头，充值后即可用。
DEEPSEEK_KEY=

# 【必需】高德开放平台 Key —— 用于地点定位、路线规划、接驳方案
# 必须申请「Web 服务」类型！
# 获取地址：高德开放平台控制台 → 应用管理 → 添加 Key → 服务平台选「Web服务」
AMAP_KEY=

# 【可选】阿里云百炼（DashScope）API Key —— 仅用于「截图识别」
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY
# 格式：sk- 开头 + 32 位十六进制（注意不要填成 RAM AccessKey 或密钥对）
#
# 不填的后果：只是「🖼 上传截图」功能不可用（页面会明确提示），
#            「📝 攻略文本」识别完全不受影响，其余功能全部正常。
DASHSCOPE_KEY=

# 【可选】腾讯位置服务 Key —— 用于「到达点搜索」（车站 / 机场）
# 获取地址：腾讯位置服务控制台 → 应用管理 → 添加 Key → 勾选「WebService API」
# 不填的后果：仅「到达点搜索」搜不到结果，接驳方案退化为按坐标距离估算
#            （仍可正常显示费用与时间）。
TMAP_KEY=
